# Optional analytics providers. Vercel Web Analytics is always on when deployed
# to Vercel (custom events need the Pro plan). Set one of these for a free
# provider with custom events; Utils/Analytics.js injects the snippet.

# Plausible (hosted or self-hosted)
# VITE_PLAUSIBLE_DOMAIN=cove.niri.dev
# VITE_PLAUSIBLE_SRC=https://plausible.io/js/script.tagged-events.js

# Umami
# VITE_UMAMI_SRC=https://cloud.umami.is/script.js
# VITE_UMAMI_ID=00000000-0000-0000-0000-000000000000

# Canonical URL used for Open Graph tags (no trailing slash)
# VITE_SITE_URL=https://niris-cove.vercel.app
